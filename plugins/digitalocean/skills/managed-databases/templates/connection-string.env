# Database connection string template
# Replace values from: doctl databases connection <db-id>

DATABASE_URL=postgresql://{{USER}}:{{PASSWORD}}@{{HOST}}:{{PORT}}/{{DATABASE}}?sslmode=require

# For connection pooling (recommended for serverless)
DATABASE_URL_POOLED=postgresql://{{USER}}:{{PASSWORD}}@{{HOST}}:{{POOL_PORT}}/{{DATABASE}}?sslmode=require
